# MongoDB persistence for snapshots, polling state, and notification history.
MONGODB_URI=

# CookMyBots X Proxy. Required. Do not call X directly from this bot.
COOKMYBOTS_X_ENDPOINT=
COOKMYBOTS_X_KEY=

# Account to monitor. Example: elonmusk or @elonmusk.
# If empty, the bot tries to monitor the authenticated proxy-managed X account.
X_MONITORED_USERNAME=

# Poll interval in milliseconds. Defaults to 300000 and is clamped to at least 300000.
X_POLL_INTERVAL_MS=300000

# Notification delivery mode: post or dm. Defaults to post.
X_NOTIFICATION_MODE=post

# Required only when X_NOTIFICATION_MODE=dm.
X_NOTIFICATION_TARGET_USER_ID=

# Optional debug diagnostics. Never logs secrets.
X_DEBUG=0
X_LOG_BODY=0

# Auto-synced env keys detected from process.env usage:
MAX_FOLLOWING_PAGES_PER_SCAN=
POLL_INTERVAL_MS=

